@page "/ordinateurs"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using GestionOrdinateurs.Shared
@inject HttpClient Http
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage

<h3>Ordinateurs</h3>

@if (!string.IsNullOrEmpty(erreur))
{
    <p class="text-danger">@erreur</p>
}
else if (ordinateurs is null)
{
    <p>Chargement...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prix</th>
                <th>Devise</th>
                <th>Vendu</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ordinateur in ordinateurs)
            {
                <tr>
                    <td>@ordinateur.Nom</td>
                    <td>@ordinateur.Prix.ToString("F2")</td>
                    <td>EUR</td>
                    <td>@(ordinateur.Vendu ? "Oui" : "Non")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (ordinateurs.Count == 0)
    {
        <p>Aucun ordinateur.</p>
    }
}

@code {
    private List<Ordinateur>? ordinateurs;
    private string erreur = "";

    protected override async Task OnInitializedAsync()
    {
        var token = await SessionStorage.GetItemAsync<string>("jwtToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            erreur = "Veuillez vous connecter.";
            return;
        }

        try
        {
            using var requete = new HttpRequestMessage(
                HttpMethod.Get, "http://localhost:5010/api/ordinateurs");

            requete.Headers.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            using var reponse = await Http.SendAsync(requete);
            reponse.EnsureSuccessStatusCode();

            ordinateurs = await reponse.Content
                .ReadFromJsonAsync<List<Ordinateur>>()
                ?? throw new System.Text.Json.JsonException("Réponse vide.");
        }
        catch (HttpRequestException ex)
        {
            erreur = $"Impossible de charger les ordinateurs : {ex.Message}";
        }
        catch (System.Text.Json.JsonException)
        {
            erreur = "La réponse de l'API est invalide.";
        }
    }
}