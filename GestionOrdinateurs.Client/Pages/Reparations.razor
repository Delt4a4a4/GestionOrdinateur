@page "/reparations"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage

<h3>Historique des réparations</h3>

@if (!string.IsNullOrEmpty(erreur))
{
    <p class="text-danger">@erreur</p>
}
else if (reparations is null)
{
    <p>Chargement...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ordinateur</th>
                <th>Technicien</th>
                <th>Type de réparation</th>
                <th>Date d'intervention</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reparation in reparations)
            {
                <tr>
                    <td>@reparation.NomOrdinateur</td>
                    <td>@reparation.Technicien</td>
                    <td>@reparation.TypeReparation</td>
                    <td>@reparation.DateIntervention.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (reparations.Count == 0)
    {
        <p>Aucune réparation.</p>
    }
}

@code {
    private List<HistoriqueReparation>? reparations;
    private string erreur = "";

    protected override async Task OnInitializedAsync()
    {
        var token = await SessionStorage.GetItemAsync<string>("jwtToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            erreur = "Veuillez vous connecter.";
            return;
        }

        try
        {
            using var requete = new HttpRequestMessage(
                HttpMethod.Get,
                "http://localhost:5010/api/reparations/historique");

            requete.Headers.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            using var reponse = await Http.SendAsync(requete);
            reponse.EnsureSuccessStatusCode();

            reparations = await reponse.Content
                .ReadFromJsonAsync<List<HistoriqueReparation>>()
                ?? throw new System.Text.Json.JsonException("Réponse vide.");
        }
        catch (HttpRequestException ex)
        {
            erreur = $"Impossible de charger les réparations : {ex.Message}";
        }
        catch (System.Text.Json.JsonException)
        {
            erreur = "La réponse de l'API est invalide.";
        }
    }

    public record HistoriqueReparation(
        int OrdinateurId,
        string NomOrdinateur,
        string Technicien,
        string TypeReparation,
        DateTime DateIntervention);
}