@page "/login"
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject NavigationManager Navigation

<h3>Connexion</h3>

<InputText @bind-Value="username" class="form-control" placeholder="Nom d'utilisateur" />
<InputText @bind-Value="password" type="password" class="form-control mt-2" placeholder="Mot de passe" />

<button class="btn btn-primary mt-2" @onclick="Connecter">
    Se connecter
</button>

<p class="text-danger">@error</p>

@code {
    private string username = "";
    private string password = "";
    private string error = "";

    private async Task Connecter()
    {
        error = "";

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            error = "Veuillez saisir un nom d'utilisateur et un mot de passe.";
            return;
        }

        try
        {
            using var response = await Http.PostAsJsonAsync(
                "http://localhost:5035/api/auth/login",
                new { username, password });

            if (!response.IsSuccessStatusCode)
            {
                error = "Connexion refusée. Vérifie les identifiants et la configuration Keycloak.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<TokenResult>();

            if (string.IsNullOrWhiteSpace(result?.AccessToken))
            {
                error = "Keycloak n'a pas renvoyé de jeton d'accès.";
                return;
            }

            await SessionStorage.SetItemAsync("jwtToken", result.AccessToken);
            Navigation.NavigateTo("/ordinateurs");
        }
        catch (HttpRequestException)
        {
            error = "Impossible de joindre l'API d'authentification.";
        }
    }

    private sealed class TokenResult
    {
        [JsonPropertyName("access_token")]
        public string AccessToken { get; set; } = "";
    }
}